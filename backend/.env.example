# Existing database and Clerk settings are required for local API development.
DB_URL=jdbc:postgresql://localhost:5432/uniwork?sslmode=require
DB_USERNAME=
CLERK_SECRET_KEY=
# Optional Clerk Backend API override for local integration tests.
CLERK_API_URL=https://api.clerk.com/v1
WATCHLIST_LOW_RATING_THRESHOLD=2
WATCHLIST_SERIOUS_REPORT_THRESHOLD=2
DB_PASSWORD=
CLERK_ISSUER_URI=
CLERK_JWKS_URI=
CLERK_JWT_AUDIENCE=
CLERK_AUTHORIZED_PARTIES=http://localhost:3000
UNIWORK_PII_ENCRYPTION_KEY=
# Optional AI features. Keep this file secret-free.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Private NIC review storage. Set only in the backend environment.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=uniwork-identity
R2_ENDPOINT=
IDENTITY_REVIEW_RETENTION_DAYS=30
IDENTITY_ORPHAN_GRACE_DAYS=45
DB_POOL_MAX_SIZE=3
DB_POOL_MIN_IDLE=0

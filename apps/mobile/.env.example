# Public Clerk key for the same UniWork Clerk instance used by the web app.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_with_your_clerk_publishable_key

# Android emulator host to the backend on the development computer.
# For a physical device, replace with your computer's LAN address.
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8080

# Public web origin for the guardian link. Use a reachable HTTPS address on a physical device.
EXPO_PUBLIC_WEB_BASE_URL=http://10.0.2.2:3000

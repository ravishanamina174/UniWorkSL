{
  "expo": {
    "name": "UniWorkSL",
    "slug": "uniwork-student",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "uniwork",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "lk.uniwork.student"
    },
    "android": {
      "package": "lk.uniwork.student",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#7C3AED",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": true,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "@clerk/expo",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash.png",
          "backgroundColor": "#7C3AED",
          "imageWidth": 220,
          "dark": {
            "image": "./assets/images/splash.png",
            "backgroundColor": "#241B38"
          }
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "UniWork uses your location once after you choose Start Task to submit an arrival check. It does not track your location in the background."
        }
      ],
      "expo-web-browser",
      ["expo-image-picker", { "photosPermission": "Choose a NIC photo for document matching or private safety team review.", "cameraPermission": false, "microphonePermission": false }],
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "7ae9ce04-b9e3-472b-b651-9df870c4fd3a"
      }
    },
    "owner": "ravi-expo"
  }
}
